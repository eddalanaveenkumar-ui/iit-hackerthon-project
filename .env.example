# ---------- Core ----------
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---------- Database ----------
# Option A (default): embedded MongoDB-compatible engine, zero setup.
DB_MODE=embedded
DB_PATH=./server/.data/learnmate
DB_PORT=27017
# Option B: real MongoDB Atlas / self-hosted
# DB_MODE=external
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/learnmate

# ---------- Auth ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---------- Encryption (for provider API keys at rest) ----------
# 32+ random chars. Rotating this invalidates stored provider credentials.
SECRET_ENCRYPTION_KEY=change-me-to-another-long-random-string

# ---------- AI provider (NVIDIA NIM) ----------
# Can also be set from the Admin > AI Provider Settings UI (stored encrypted).
# NVIDIA_API_KEY is the shared fallback. Prefer the per-model slots below: NIM
# rate limits are per key, so sharing one key across six models means they all
# draw on the same quota.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ---------- AI provider: per-model keys (one slot per model) ----------
# Set any subset. A model resolves its key in this order:
#   Admin panel key (encrypted in the database) -> its slot here -> NVIDIA_API_KEY
# Unset slots fall through cleanly, so a single NVIDIA_API_KEY still works.
NVIDIA_API_KEY_LIGHTNING=        # nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_API_KEY_ULTRA=            # nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_API_KEY_EMBED=            # nvidia/nemotron-3.5-embed-1b
NVIDIA_API_KEY_RERANK=           # nvidia/nemotron-3.5-rerank-8b
NVIDIA_API_KEY_PARSE=            # nvidia/nemotron-3.5-parse
NVIDIA_API_KEY_DEEPSEEK=         # deepseek-ai/deepseek-v4.1-flash (also the vision model)

# Reserved: these two models are not served by NVIDIA, so a key here has no
# effect today. Kept so the slot exists if they ship.
# NVIDIA_API_KEY_SAFETY=         # nvidia/nemotron-content-safety-reasoning-4b
# NVIDIA_API_KEY_QWEN=           # qwen/qwen2.5-coder-32b-instruct
# Must stay below the serverless function budget (server/vercel.json maxDuration).
# When these were both 60s, a slow model produced a platform 504 instead of a
# clean timeout, so the chat turn looked broken rather than slow.
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# ---------- Seed demo data (true/false) ----------
SEED_DEMO=true
